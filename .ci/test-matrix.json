{
  "schema": 1,
  "environments": [
    {
      "id": "ubuntu-node22-python313",
      "runner": "ubuntu-latest",
      "required": true,
      "os": "ubuntu-latest",
      "runtimes": {
        "node": "22",
        "python": "3.13"
      },
      "probes": [
        {"name": "node", "command": ["node", "--version"]},
        {"name": "npm", "command": ["npm", "--version"]}
      ],
      "steps": [
        {"name": "CI contract regression", "kind": "validation", "command": ["python", "-m", "unittest", "tests/test_ci_contract.py"]},
        {"name": "Production JSDoc coverage", "kind": "validation", "command": ["node", "scripts/check-jsdoc.mjs"]},
        {"name": "Core test suite", "kind": "validation", "command": ["npm", "test"]},
        {"name": "Phase 2 integrity gate", "kind": "validation", "command": ["python", "tests/validate-phase2-baseline.py"]},
        {"name": "Canonical ChatGPT golden", "kind": "validation", "command": ["python", "tests/validate-canonical-golden.py"]},
        {"name": "Canonical Claude golden", "kind": "validation", "command": ["python", "tests/validate-claude-canonical-golden.py"]},
        {"name": "Canonical Codex golden", "kind": "validation", "command": ["python", "tests/validate-codex-canonical-golden.py"]},
        {"name": "Provider example regressions", "kind": "validation", "command": ["python", "tests/validate-provider-example-regressions.py"]},
        {"name": "Diff hygiene", "kind": "validation", "command": ["git", "diff", "--check"]}
      ]
    }
  ]
}
